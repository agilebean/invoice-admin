# Example environment (copy to `.env` — gitignored). Never commit real URLs with tokens.
#
# After Spark HTML export and PDF save / move:
# GOOGLEADS_INVOICE_MAIL_HTML=/path/to/billing_mail.html
# GOOGLEADS_INVOICE_PDF=/path/to/invoice.pdf
#
# Optional: local-only integration check against copies on disk (CI does not use these).
# GOOGLEADS_INVOICE_MAIL_HTML=/Users/you/example/redacted_billing.html
# GOOGLEADS_INVOICE_PDF=/Users/you/Downloads/google_invoice.pdf

GOOGLEADS_INVOICE_MAIL_HTML=
GOOGLEADS_INVOICE_PDF=

# Optional (Iteration 9.1): paste monthly billing short link from mail — never commit the value.
# GOOGLEADS_BILLING_DEEPLINK=https://c.gle/...

# Attach Selenium to YOUR running Brave (--remote-debugging-port).
# GOOGLEADS_BROWSER_DEBUGGER_ADDRESS=127.0.0.1:9222

# Live Brave pytest: optional trace dumps (HTML + PNG) when RUN_LIVE_BRAVE_TRACE=1
# RUN_LIVE_BRAVE_TRACE=1
# GOOGLEADS_LIVE_BRAVE_TRACE_DIR=/Users/you/Downloads

# Live pytest (see README): never enable in CI.
# RUN_LIVE_BRAVE=1
# RUN_LIVE_SPARK=1

# HTML file you saved/exported from Spark (billing mail) for live_spark parsing test.
# GOOGLEADS_SPARK_MAIL_HTML=/path/to/export.html

# Canonical addresses (optional overrides — CLI defaults match these if unset).
GOOGLEADS_GMAIL_SMTP_USER=chaehan.so@gmail.com
# Test sends / Mail drafts default To: if --to omitted (override for Jack monthly):
GOOGLEADS_INVOICE_TO=chaehan.so@virtualfriend.chat
# GOOGLEADS_INVOICE_TO=jack.copeland@theglugglejugfactory.com

# Gmail SMTP for `invoice send` (production). App Password from Google Account security.
# GOOGLEADS_GMAIL_SMTP_APP_PASSWORD=

# Prefer a local file (first line = app password; chmod 600; never commit) over inline env:
# GOOGLEADS_GMAIL_SMTP_APP_PASSWORD_FILE=~/.gmail/gmail-smtp-app-password
# SMTP login user:
# GOOGLEADS_GMAIL_SMTP_USER=chaehan.so@gmail.com

# Gmail API read (send/save): path to authorized-user OAuth token JSON (gmail.readonly).
# GOOGLE_OAUTH_TOKEN=~/.google/oauth_token.json
# Optional override for the default billing notification search:
# GOOGLEADS_GMAIL_BILLING_QUERY=from:payments-noreply@google.com subject:"Google Ads: Your billing document is ready"
# Optional override for the commission mail search:
# GOOGLEADS_COMMISSION_QUERY=from:jack.copeland@theglugglejugfactory.com commission

# send (production): Brave debugger address override (handler reads billing.brave_debug_port from YAML).
# GOOGLEADS_BROWSER_DEBUGGER_ADDRESS=127.0.0.1:9222

# --- invoice_admin (new package; see docs/IMPLEMENTATION_PLAN_invoice_handler.md) ---
# INVOICE_ADMIN_REPO_ROOT=/path/to/invoice-admin
# INVOICE_ADMIN_ROOT=~/Documents/Invoices
# NTFY_TOPIC=
# INVOICE_ADMIN_IBAN_SELF=
# INVOICE_ADMIN_ACCOUNT_HOLDER=
# FINTS_PIN=
# INVOICE_ADMIN_FINTS_LOGIN=
# INVOICE_ADMIN_FINTS_PRODUCT_ID=
# ANTHROPIC_API_KEY=

# invoice ingest --email <readdle-spark://…> (IMAP fetch by Message-ID)
# INVOICE_ADMIN_IMAP_HOST=imap.example.com
# INVOICE_ADMIN_IMAP_USER=you@example.com
# INVOICE_ADMIN_IMAP_PASSWORD=
# Optional poll interval seconds for `invoice watch --source imap` (default 60, min 10):
# INVOICE_ADMIN_IMAP_POLL_SECONDS=120

# Foyer Global Health (Playwright; credentials only in env)
# FOYER_USERNAME=
# FOYER_PASSWORD=
# FOYER_PLAYWRIGHT_HEADLESS=1
